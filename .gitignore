## A streamlined .gitignore for modern .NET projects,
## including temporary files, build results, and IDE files.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# .NET
project.lock.json
project.fragment.lock.json
*.binlog

# Visual Studio and Rider
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test and coverage output
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage/
CodeCoverage/
*.coverage
*.coveragexml
*.VisualState.xml
TestResult.xml
nunit-*.xml

# NuGet
*.nupkg
*.snupkg
packages/

# Logs and local environment
*.log
.env
.env.*

# OS and editor files
Thumbs.db
Desktop.ini
~$*
*~
